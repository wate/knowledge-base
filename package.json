{
  "name": "knowledge-base",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "zx tests/run.mjs",
    "detect-unk": "zx knowledge-base.mjs dict detect",
    "export-unknown-words": "zx knowledge-base.mjs dict export-unknown-words",
    "import-unknown-words": "zx knowledge-base.mjs dict import-unknown-words",
    "export-pos-master": "zx knowledge-base.mjs dict export-pos-master",
    "import-pos-master": "zx knowledge-base.mjs dict import-pos-master",
    "export-user-dict": "zx knowledge-base.mjs dict export-user-dict",
    "export-user-dict-detailed": "zx knowledge-base.mjs dict export-user-dict --detailed",
    "build-user-dict": "zx knowledge-base.mjs dict export-user-dict && mkdir -p dict/user && lindera build --src dict/user-dict.csv --dest dict/user --metadata dict/system/metadata.json --user"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.1",
    "@huggingface/transformers": "^4.2.0",
    "graphology": "^0.25.4",
    "graphology-pagerank": "^1.1.0",
    "lindera": "^6.2.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "picomatch": "^4.0.5",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-stringify": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  }
}
