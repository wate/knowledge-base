{
  "name": "knowledge-base",
  "private": true,
  "type": "module",
  "scripts": {
    "detect-unk": "zx detect-unk.mjs",
    "export-unknown-words": "zx export-unknown-words.mjs",
    "import-unknown-words": "zx import-unknown-words.mjs",
    "export-pos-master": "zx export-pos-master.mjs",
    "import-pos-master": "zx import-pos-master.mjs",
    "export-user-dict": "zx export-user-dict.mjs",
    "export-user-dict-detailed": "zx export-user-dict.mjs --detailed",
    "build-user-dict": "zx export-user-dict.mjs && mkdir -p dict/user_dictionary && lindera build --src dict/user-dict.csv --dest dict/user_dictionary --metadata dict/lindera-ipadic/metadata.json --user"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "graphology": "^0.25.4",
    "graphology-pagerank": "^1.1.0",
    "lindera-nodejs": "^4.0.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-stringify": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  }
}
